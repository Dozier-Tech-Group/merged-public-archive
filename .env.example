# Owner/operator key for deploys and owner calls. NEVER commit a real key,
# never paste one into chat or an issue. The file .env is gitignored.
PRIVATE_KEY=
# Optional RPC overrides (defaults are the public Robinhood Chain endpoints)
RH_RPC_URL=
RH_TESTNET_RPC_URL=
# Pinata JWT for IPFS pinning (scripts/pin-mp*.mjs)
PINATA_JWT=
