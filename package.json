{
  "name": "merged-public-archive",
  "private": true,
  "version": "1.0.0",
  "description": "Merged Public — the 10,000-entity archive on Robinhood Chain: contracts, provenance, sealed metadata, the fleet board, and the full public record.",
  "license": "MIT",
  "scripts": {
    "test": "hardhat test && vitest run",
    "test:contracts": "hardhat test",
    "test:app": "vitest run",
    "compile": "hardhat compile",
    "deploy:board:mainnet": "hardhat run scripts/deploy-mp-board.js --network robinhood",
    "deploy:mp:mainnet": "hardhat run scripts/deploy-merged-public.js --network robinhood",
    "deploy:mp:testnet": "hardhat run scripts/deploy-merged-public.js --network robinhoodTestnet",
    "mint:mp:mainnet": "hardhat run scripts/mint-mp.js --network robinhood",
    "mint:mp:testnet": "hardhat run scripts/mint-mp.js --network robinhoodTestnet",
    "verify:provenance": "node generator/merged-public/verify-mp.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "5.2.0",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "happy-dom": "^20.0.11",
    "hardhat": "^2.26.3",
    "ipfs-only-hash": "^4.0.0",
    "vitest": "^3.2.7"
  }
}
